# Copier ce fichier en .env et remplir les valeurs
# NE PAS committer .env dans git !

# JWT (générer une clé aléatoire longue en prod)
JWT_SECRET_KEY=tournoi-eglise-secret-key-2024-secure!

# Gmail SMTP
GMAIL_ADDRESS=votre.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Emails des responsables (séparés par des virgules)
RESPONSABLES_EMAILS=responsable1@gmail.com,responsable2@gmail.com

# Admin par défaut
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangerCeMotDePasse!

# URL du frontend (pour CORS en prod)
FRONTEND_URL=https://votre-app.vercel.app

# Environnement
FLASK_ENV=production
